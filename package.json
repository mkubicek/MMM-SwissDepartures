    "url": "git+https://github.com/mkubicek/MMM-SwissDepartures.git"
  },
  "bugs": {
    "url": "https://github.com/mkubicek/MMM-SwissDepartures/issues"
  },
  "homepage": "https://github.com/mkubicek/MMM-SwissDepartures#readme",
  "keywords": [
    "magicmirror",
    "magicmirror-module",
    "magicmirror2",
    "public-transport",
    "departures",
    "timetable",
    "switzerland",
    "sbb",
    "zvv",
    "search.ch"
  ],
  "author": "Milan Kubicek",
  "license": "MIT",
  "engines": {
    "node": ">=10"
  },
  "files": [
    "MMM-SwissDepartures.js",
